{
  "version": 2,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/stories",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/scanner",
      "destination": "/scan/",
      "permanent": true
    },
    {
      "source": "/premium",
      "destination": "/consultation.html",
      "permanent": true
    },
    {
      "source": "/passterra_authority_dictionary.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/passterra(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/widget-bazi-wealth.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/blog1.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog1-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog2.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog2-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog3.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog3-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/passterra",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calculator",
      "destination": "/free-chart.html",
      "permanent": true
    },
    {
      "source": "/calculator/:path*",
      "destination": "/free-chart.html",
      "permanent": true
    },
    {
      "source": "/blog/:slug.md",
      "destination": "/blog/:slug.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!hubs/|blog/|scan/|longtail/|images/|pages/|api/|js/|[a-z0-9_-]+\\.[a-z0-9]+).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/checkout.mjs": {
      "memory": 128,
      "maxDuration": 10,
      "includeFiles": "**"
    },
    "api/generate-reading.js": {
      "maxDuration": 30
    },
    "api/collect-lead.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/lib/**"
    },
    "api/gumroad-ping.mjs": {
      "maxDuration": 15,
      "includeFiles": "server/lib/**"
    }
  }
}