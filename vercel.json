{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/stories", "destination": "/blog/index.html", "permanent": true },
    { "source": "/scanner", "destination": "/scan/", "permanent": true },
    { "source": "/premium", "destination": "#blueprint", "permanent": true }
  ]
}
