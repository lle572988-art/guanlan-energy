{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/confirm",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/hubs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/longtail/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/scan/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/thank-you.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(free-chart|consultation|faq|thank-you|bazi-calculator|feng-shui-scan|ziwei-results|privacy|terms|about|pricing|checkout|subscribe|contact|stories|scanner|premium|calculator)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/stories",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/scanner",
      "destination": "/scan/",
      "permanent": true
    },
    {
      "source": "/premium",
      "destination": "/consultation.html",
      "permanent": true
    },
    {
      "source": "/passterra_authority_dictionary.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/passterra(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/widget-bazi-wealth.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/article-detail.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/blog1.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog1-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog2.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog2-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog3.html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/blog/blog3-:num(\\d+).html",
      "destination": "/blog/index.html",
      "permanent": true
    },
    {
      "source": "/passterra",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calculator",
      "destination": "/free-chart.html",
      "permanent": true
    },
    {
      "source": "/calculator/:path*",
      "destination": "/free-chart.html",
      "permanent": true
    },
    {
      "source": "/blog/:slug.md",
      "destination": "/blog/:slug.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/consultation",
      "has": [{ "type": "query", "key": "intent" }],
      "destination": "/consultation.html"
    },
    {
      "source": "/free-chart",
      "destination": "/free-chart.html"
    },
    {
      "source": "/consultation",
      "destination": "/consultation.html"
    },
    {
      "source": "/compass",
      "destination": "/compass/index.html"
    },
    {
      "source": "/compass/",
      "destination": "/compass/index.html"
    },
    {
      "source": "/compass/xray",
      "destination": "/compass/xray/index.html"
    },
    {
      "source": "/compass/xray/",
      "destination": "/compass/xray/index.html"
    },
    {
      "source": "/compass/kua/:num",
      "destination": "/compass/kua/:num.html"
    },
    {
      "source": "/compass/guides/:slug",
      "destination": "/compass/guides/:slug.html"
    },
    {
      "source": "/compass/guides",
      "destination": "/compass/guides/index.html"
    },
    {
      "source": "/compass/guides/",
      "destination": "/compass/guides/index.html"
    },
    {
      "source": "/compass/order",
      "destination": "/compass/order/index.html"
    },
    {
      "source": "/compass/order/",
      "destination": "/compass/order/index.html"
    },
    {
      "source": "/compass/heatmap",
      "destination": "/compass/heatmap/index.html"
    },
    {
      "source": "/compass/heatmap/",
      "destination": "/compass/heatmap/index.html"
    },
    {
      "source": "/compass/family",
      "destination": "/compass/family/index.html"
    },
    {
      "source": "/compass/family/",
      "destination": "/compass/family/index.html"
    },
    {
      "source": "/compass/moving",
      "destination": "/compass/moving/index.html"
    },
    {
      "source": "/compass/moving/",
      "destination": "/compass/moving/index.html"
    },
    {
      "source": "/compass/facing/:slug",
      "destination": "/compass/facing/:slug.html"
    },
    {
      "source": "/compass/city/:slug",
      "destination": "/compass/city/:slug.html"
    },
    {
      "source": "/compass/city",
      "destination": "/compass/city/index.html"
    },
    {
      "source": "/compass/city/",
      "destination": "/compass/city/index.html"
    },
    {
      "source": "/compass/born/:year",
      "destination": "/compass/born/:year.html"
    },
    {
      "source": "/compass/2026/zodiac/:animal",
      "destination": "/compass/2026/zodiac/:animal.html"
    },
    {
      "source": "/compass/2026/zodiac",
      "destination": "/compass/2026/zodiac/index.html"
    },
    {
      "source": "/compass/2026/zodiac/",
      "destination": "/compass/2026/zodiac/index.html"
    },
    {
      "source": "/compass/2026/:slug",
      "destination": "/compass/2026/:slug.html"
    },
    {
      "source": "/((?!hubs/|blog/|scan/|compass/|longtail/|images/|pages/|api/|js/|[a-z0-9_-]+\\.[a-z0-9]+).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/checkout.mjs": {
      "memory": 128,
      "maxDuration": 10,
      "includeFiles": "**"
    },
    "api/generate-reading.js": {
      "maxDuration": 30
    },
    "api/generate-image.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/compass-cure-image.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/collect-lead.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/lib/**"
    },
    "api/gumroad-ping.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/lib/**"
    },
    "api/stripe-webhook.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/lib/**"
    },
    "api/cron/compass-monthly.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/compass-monthly",
      "schedule": "0 9 1 * *"
    }
  ]
}
