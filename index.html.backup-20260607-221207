<style>
:root {
  --void: #03070F;
  --deep: #060D1A;
  --surface: #0C1628;
  --layer: #111E35;
  --rim: #1A2D4A;
  --gold: #C5984A;
  --gold-light: #E2C27A;
  --gold-dim: #7A5C28;
  --silver: #9BB5CC;
  --silver-dim: #4A6680;
  --amethyst: #5C3D7A;
  --amethyst-glow: rgba(92, 61, 122, 0.25);
  --parchment: #D4C4A0;
  --text: #C8D8E8;
  --text-dim: #6A8299;
  --r: 0.5rem;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--void);
  color: var(--text);
  font-family: 'EB Garamond', Georgia, serif;
  font-size: 17px;
  line-height: 1.65;
  overflow-x: hidden;
  cursor: default;
}

/* ─── STAR FIELD ─── */
#starfield {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  overflow: hidden;
}
#starfield canvas { width: 100%; height: 100%; }

/* ─── NAV ─── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.2rem 4rem;
  border-bottom: 1px solid rgba(197, 152, 74, 0.12);
  background: linear-gradient(to bottom, rgba(3,7,15,0.92) 0%, transparent 100%);
  backdrop-filter: blur(8px);
}
.nav-brand {
  display: flex; align-items: center; gap: 0.9rem;
}
.nav-sigil {
  width: 36px; height: 36px;
  opacity: 0.9;
}
.nav-name {
  font-family: 'Cinzel', serif;
  font-size: 0.78rem;
  letter-spacing: 0.18em;
  color: var(--gold);
  text-transform: uppercase;
  line-height: 1.3;
}
.nav-name span {
  display: block;
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  color: var(--silver-dim);
  font-family: 'EB Garamond', serif;
  font-style: italic;
}
.nav-links {
  display: flex; align-items: center; gap: 2.4rem;
  list-style: none;
}
.nav-links a {
  font-family: 'Cinzel', serif;
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  color: var(--silver-dim);
  text-decoration: none;
  text-transform: uppercase;
  transition: color 0.3s;
}
.nav-links a:hover { color: var(--gold); }
.nav-cta {
  font-family: 'Cinzel', serif;
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--void) !important;
  background: var(--gold);
  padding: 0.55rem 1.4rem;
  border-radius: 1px;
  transition: background 0.3s, box-shadow 0.3s !important;
}
.nav-cta:hover { background: var(--gold-light) !important; box-shadow: 0 0 20px rgba(197,152,74,0.4) !important; }

/* ─── HERO ─── */
#hero {
  position: relative; z-index: 1;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rem 0;
  overflow: hidden;
}


.hero-container {
  display: grid;
  grid-template-columns: 4fr 8fr;
  gap: 40px;
  align-items: center;
  max-width: 1300px;
  width: 100%;
  margin: 0 auto;
  padding: 0 48px;
}

/* nebula glow behind chart */
#hero::after {
  content: '';
  position: absolute; right: -5%; top: 50%; transform: translateY(-50%);
  width: 50vw; height: 85vh;
  background: radial-gradient(ellipse at center,
    rgba(92,61,122,0.12) 0%,
    rgba(226,194,122,0.04) 30%,
    transparent 70%);
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
}

.hero-left {
  padding: 0;
  position: relative; z-index: 2;
}

.hero-eyebrow {
  font-family: 'Cinzel', serif;
  font-size: 0.62rem;
  letter-spacing: 0.28em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 1.6rem;
  display: flex; align-items: center; gap: 0.7rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.2s forwards;
}
.hero-eyebrow::before {
  content: '';
  display: inline-block;
  width: 32px; height: 1px;
  background: var(--gold);
  opacity: 0.6;
}

.hero-h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.2rem, 3.2vw, 3.2rem);
  font-weight: 300;
  line-height: 1.15;
  color: var(--parchment);
  letter-spacing: -0.01em;
  margin-bottom: 0.3rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.35s forwards;
}
.hero-h1 em {
  font-style: italic;
  color: var(--gold-light);
}

.hero-subtitle {
  font-family: 'Cormorant Garamond', serif;
  font-size: 0.95rem;
  font-weight: 300;
  font-style: italic;
  color: var(--silver-dim);
  letter-spacing: 0.04em;
  margin-bottom: 1rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.45s forwards;
}

.hero-body {
  font-size: 0.95rem;
  color: var(--text-dim);
  line-height: 1.6;
  max-width: 400px;
  margin-bottom: 1rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.55s forwards;
}
.hero-body strong { color: var(--silver); font-weight: 500; }

.trust-row {
  display: flex; align-items: center; gap: 1rem;
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.65s forwards;
}
.trust-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--gold);
}
.trust-row span {
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  color: var(--text-dim);
  text-transform: uppercase;
}

/* ─── FORM ─── */
.chart-form {
  background: rgba(12, 22, 40, 0.7);
  border: 1px solid rgba(197,152,74,0.18);
  border-radius: 2px;
  padding: 1.5rem;
  max-width: 380px;
  position: relative;
  opacity: 0;
  animation: fadeUp 0.9s 0.75s forwards;
}
.chart-form::before {
  content: '';
  position: absolute; top: -1px; left: 10%; right: 10%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.form-title {
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 0.8rem;
}

.form-row { margin-bottom: 1rem; }
.form-label {
  display: block;
  font-family: 'Cinzel', serif;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  color: var(--silver-dim);
  text-transform: uppercase;
  margin-bottom: 0.4rem;
}
.form-input, .form-select {
  width: 100%;
  background: rgba(6, 13, 26, 0.8);
  border: 1px solid rgba(74, 102, 128, 0.4);
  color: var(--text);
  font-family: 'EB Garamond', serif;
  font-size: 0.95rem;
  padding: 0.6rem 0.9rem;
  border-radius: 1px;
  outline: none;
  transition: border-color 0.3s, box-shadow 0.3s;
  appearance: none;
}
.form-input:focus, .form-select:focus {
  border-color: var(--gold-dim);
  box-shadow: 0 0 0 1px rgba(197,152,74,0.2), 0 0 12px rgba(197,152,74,0.08);
}
.form-select { cursor: pointer; }
.form-select option { background: #0A1525; }

.form-hint {
  font-size: 0.75rem;
  font-style: italic;
  color: var(--text-dim);
  margin-top: 0.25rem;
}

.btn-primary {
  width: 100%;
  margin-top: 1.4rem;
  background: var(--gold);
  color: var(--void);
  font-family: 'Cinzel', serif;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border: none;
  padding: 1rem;
  border-radius: 1px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: background 0.3s, box-shadow 0.3s, transform 0.15s;
}
.btn-primary::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
  pointer-events: none;
}
.btn-primary:hover {
  background: var(--gold-light);
  box-shadow: 0 4px 30px rgba(197,152,74,0.45);
  transform: translateY(-1px);
}
.btn-primary:active { transform: translateY(0); }

.form-sub {
  text-align: center;
  margin-top: 0.9rem;
  font-size: 0.78rem;
  font-style: italic;
  color: var(--text-dim);
}
.form-sub span { color: var(--gold); }

/* ─── HERO CHART ─── */
.hero-right {
  position: relative; z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

#zwds-chart {
  width: min(680px, 92%);
  height: min(680px, 92%);
  position: relative;
}

/* ─── DIVIDER ─── */
.section-divider {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 1.5rem;
  padding: 0 4.5rem;
  margin: 2rem 0;
  opacity: 0.35;
}
.section-divider::before, .section-divider::after {
  content: ''; flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim));
}
.section-divider::after {
  background: linear-gradient(90deg, var(--gold-dim), transparent);
}
.divider-glyph {
  font-family: 'Cinzel', serif;
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  color: var(--gold-dim);
  white-space: nowrap;
}

/* ─── SECTION BASE ─── */
section {
  position: relative; z-index: 1;
}
.section-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 4rem;
}

.section-label {
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  color: var(--gold);
  text-transform: uppercase;
  display: flex; align-items: center; gap: 0.8rem;
  margin-bottom: 1rem;
}
.section-label::before {
  content: '';
  display: inline-block;
  width: 24px; height: 1px;
  background: var(--gold);
  opacity: 0.6;
}

.section-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3vw, 3rem);
  font-weight: 300;
  color: var(--parchment);
  line-height: 1.2;
  margin-bottom: 1.2rem;
}
.section-heading em { font-style: italic; color: var(--gold-light); }

/* ─── PREVIEW SECTION ─── */
#preview {
  padding: 5rem 0;
  background: linear-gradient(to bottom, var(--void) 0%, var(--deep) 50%, var(--void) 100%);
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  border: 1px solid rgba(197,152,74,0.15);
  background: rgba(197,152,74,0.08);
  max-width: 820px;
  margin: 3rem auto 0;
  position: relative;
}
.preview-grid::before {
  content: 'SAMPLE CHART — YOUR CHART WILL BE UNIQUE';
  position: absolute;
  top: -1.6rem; left: 50%; transform: translateX(-50%);
  font-family: 'Cinzel', serif;
  font-size: 0.55rem;
  letter-spacing: 0.22em;
  color: var(--silver-dim);
  white-space: nowrap;
}
.palace-preview {
  background: var(--deep);
  padding: 1.2rem;
  border: 1px solid rgba(26,45,74,0.8);
  position: relative;
  min-height: 90px;
  transition: background 0.3s;
}
.palace-preview:hover { background: var(--surface); }
.palace-preview.locked::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(3,7,15,0.7);
  backdrop-filter: blur(4px);
  z-index: 1;
}
.palace-name-zh {
  font-size: 0.68rem;
  color: var(--gold-dim);
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 0.15rem;
}
.palace-name-en {
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.12em;
  color: var(--silver-dim);
  display: block;
  margin-bottom: 0.6rem;
  text-transform: uppercase;
}
.palace-stars {
  font-size: 0.85rem;
  color: var(--silver);
  line-height: 1.5;
}
.palace-stars .star-main { color: var(--gold-light); font-weight: 500; }
.palace-stars .star-secondary { color: var(--silver-dim); font-size: 0.78rem; }
.unlock-badge {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  z-index: 2;
  background: rgba(197,152,74,0.12);
  border: 1px solid rgba(197,152,74,0.3);
  padding: 0.3rem 0.7rem;
  border-radius: 1px;
  font-family: 'Cinzel', serif;
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  color: var(--gold);
  text-transform: uppercase;
  white-space: nowrap;
}
.palace-preview.highlight {
  border-color: rgba(197,152,74,0.4);
  box-shadow: 0 0 0 1px rgba(197,152,74,0.15) inset;
}

.preview-cta {
  text-align: center;
  margin-top: 2.5rem;
}
.preview-cta p {
  font-size: 1rem; font-style: italic;
  color: var(--text-dim);
  margin-bottom: 1.2rem;
}
.btn-outline {
  display: inline-block;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-family: 'Cinzel', serif;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.8rem 2.2rem;
  text-decoration: none;
  border-radius: 1px;
  transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  cursor: pointer;
  background: transparent;
}
.btn-outline:hover {
  background: var(--gold);
  color: var(--void);
  box-shadow: 0 0 24px rgba(197,152,74,0.35);
}

/* ─── PALACES GRID ─── */
#palaces {
  padding: 6rem 0;
}

.palaces-intro {
  max-width: 580px;
  margin-bottom: 3.5rem;
}
.palaces-intro p {
  font-size: 1.05rem;
  color: var(--text-dim);
  line-height: 1.75;
}

.palaces-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(197,152,74,0.1);
  border: 1px solid rgba(197,152,74,0.1);
}

.palace-card {
  background: var(--deep);
  padding: 1.4rem 1.2rem;
  border: 1px solid transparent;
  transition: background 0.3s, border-color 0.3s;
  cursor: default;
  position: relative;
  overflow: hidden;
}
.palace-card::before {
  content: '';
  position: absolute; top: 0; left: 0;
  width: 2px; height: 0;
  background: var(--gold);
  transition: height 0.4s;
}
.palace-card:hover { background: var(--surface); border-color: rgba(197,152,74,0.15); }
.palace-card:hover::before { height: 100%; }

.palace-num {
  font-family: 'Cinzel', serif;
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  color: var(--gold-dim);
  margin-bottom: 0.6rem;
}
.palace-zh {
  font-size: 1.3rem;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 0.2rem;
}
.palace-en {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 0.95rem;
  color: var(--silver-dim);
  margin-bottom: 0.6rem;
  display: block;
}
.palace-desc {
  font-size: 0.82rem;
  color: var(--text-dim);
  line-height: 1.55;
}

/* ─── ABOUT ─── */
#about {
  padding: 6rem 0;
  background: linear-gradient(135deg, var(--void) 0%, var(--deep) 60%, var(--void) 100%);
}

.about-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 5rem;
  align-items: start;
}

.about-portrait {
  position: relative;
}
.portrait-frame {
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--surface);
  border: 1px solid rgba(226,194,122,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.portrait-placeholder {
  text-align: center;
  color: var(--text-dim);
}
.portrait-placeholder svg { opacity: 0.25; margin-bottom: 1rem; }
.portrait-placeholder p {
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--silver-dim);
  text-transform: uppercase;
}
.portrait-corner {
  position: absolute;
  width: 16px; height: 16px;
  border-color: var(--gold);
  border-style: solid;
  opacity: 0.5;
}
.portrait-corner.tl { top: 8px; left: 8px; border-width: 1px 0 0 1px; }
.portrait-corner.tr { top: 8px; right: 8px; border-width: 1px 1px 0 0; }
.portrait-corner.bl { bottom: 8px; left: 8px; border-width: 0 0 1px 1px; }
.portrait-corner.br { bottom: 8px; right: 8px; border-width: 0 1px 1px 0; }

.about-caption {
  margin-top: 1rem;
  text-align: center;
}
.about-caption strong {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.1rem;
  color: var(--parchment);
  display: block;
}
.about-caption span {
  font-family: 'Cinzel', serif;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  color: var(--gold-dim);
  text-transform: uppercase;
}

.about-content .section-heading { margin-bottom: 0.8rem; }

.about-body {
  font-size: 1rem;
  color: var(--text-dim);
  line-height: 1.8;
  margin-bottom: 1.5rem;
}

.credentials {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin: 2rem 0;
}
.cred-item {
  border-left: 1px solid rgba(197,152,74,0.3);
  padding-left: 1rem;
}
.cred-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2rem;
  font-weight: 300;
  color: var(--gold);
  line-height: 1;
  display: block;
  margin-bottom: 0.2rem;
}
.cred-label {
  font-family: 'Cinzel', serif;
  font-size: 0.58rem;
  letter-spacing: 0.15em;
  color: var(--silver-dim);
  text-transform: uppercase;
  display: block;
}

/* ─── PRICING ─── */
#pricing {
  padding: 6rem 0;
}

.pricing-note {
  max-width: 520px;
  font-size: 1rem;
  color: var(--text-dim);
  line-height: 1.75;
  margin-bottom: 3.5rem;
  font-style: italic;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1px;
  background: rgba(197,152,74,0.08);
}

.pricing-card {
  background: var(--deep);
  padding: 2.2rem 1.8rem;
  border: 1px solid rgba(197,152,74,0.08);
  position: relative;
  transition: background 0.3s;
}
.pricing-card:hover { background: var(--surface); }
.pricing-card.featured {
  background: linear-gradient(160deg, var(--surface) 0%, #0E1D34 100%);
  border-color: rgba(197,152,74,0.35);
  z-index: 1;
}
.pricing-card.featured::before {
  content: '';
  position: absolute; top: -1px; left: 10%; right: 10%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.pricing-badge {
  position: absolute; top: -0.7rem; left: 50%; transform: translateX(-50%);
  background: var(--gold);
  color: var(--void);
  font-family: 'Cinzel', serif;
  font-size: 0.5rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.25rem 0.7rem;
  border-radius: 1px;
  white-space: nowrap;
}

.pricing-type {
  font-family: 'Cinzel', serif;
  font-size: 0.58rem;
  letter-spacing: 0.2em;
  color: var(--silver-dim);
  text-transform: uppercase;
  margin-bottom: 1rem;
