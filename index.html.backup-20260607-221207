<script>
/* ─── STARFIELD ─── */
(function() {
  const canvas = document.getElementById('stars-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, stars = [];

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  for (let i = 0; i < 280; i++) {
    stars.push({
      x: Math.random(), y: Math.random(),
      r: Math.random() * 1.2 + 0.2,
      a: Math.random(),
      speed: Math.random() * 0.004 + 0.001,
      phase: Math.random() * Math.PI * 2
    });
  }

  let t = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    t += 0.008;
    stars.forEach(s => {
      const alpha = s.a * (0.5 + 0.5 * Math.sin(t * s.speed * 60 + s.phase));
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(200, 220, 255, ${alpha})`;
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

/* ─── SVG CHART DECORATIONS ─── */
(function() {
  const svg = document.getElementById('chart-svg');
  const ns = 'http://www.w3.org/2000/svg';
  const cx = 280, cy = 280;

  // Add 72 tick marks to outer ring
  const ticksG = document.getElementById('ticks');
  for (let i = 0; i < 72; i++) {
    const angle = (i / 72) * Math.PI * 2 - Math.PI / 2;
    const r1 = 242, r2 = (i % 6 === 0) ? 232 : 238;
    const line = document.createElementNS(ns, 'line');
    line.setAttribute('x1', cx + Math.cos(angle) * r1);
    line.setAttribute('y1', cy + Math.sin(angle) * r1);
    line.setAttribute('x2', cx + Math.cos(angle) * r2);
    line.setAttribute('y2', cy + Math.sin(angle) * r2);
    ticksG.appendChild(line);
  }

  // Add 12 constellation dots on inner ring
  const consG = document.getElementById('constellation-dots');
  const constellationNames = ['子','丑','寅','卯','辰','巳','午','未','申','酉','戌','亥'];
  for (let i = 0; i < 12; i++) {
    const angle = (i / 12) * Math.PI * 2 - Math.PI / 2;
    const r = 228;
    // dot cluster
    for (let j = 0; j < 3; j++) {
      const da = (j - 1) * 0.08;
      const dr = (j === 1) ? 0 : -6;
      const circle = document.createElementNS(ns, 'circle');
      circle.setAttribute('cx', cx + Math.cos(angle + da) * (r + dr));
      circle.setAttribute('cy', cy + Math.sin(angle + da) * (r + dr));
      circle.setAttribute('r', j === 1 ? 1.8 : 1);
      circle.setAttribute('fill', '#9BB5CC');
      circle.setAttribute('opacity', j === 1 ? '0.4' : '0.2');
      consG.appendChild(circle);
    }

    // Branch name label at 210px radius
    const textEl = document.createElementNS(ns, 'text');
    const labelR = 210;
    const tx = cx + Math.cos(angle) * labelR;
    const ty = cy + Math.sin(angle) * labelR;
    textEl.setAttribute('x', tx);
    textEl.setAttribute('y', ty);
    textEl.setAttribute('text-anchor', 'middle');
    textEl.setAttribute('dominant-baseline', 'middle');
    textEl.setAttribute('font-size', '8');
    textEl.setAttribute('fill', '#7A5C28');
    textEl.setAttribute('opacity', '0.6');
    textEl.setAttribute('font-family', 'serif');
    textEl.textContent = constellationNames[i];
    consG.appendChild(textEl);
  }

  // Add random twinkling star overlay inside the chart area
  const overlayG = document.getElementById('star-overlay');
  const chartStars = [];
  for (let i = 0; i < 40; i++) {
    // Random points inside the outer rect area but outside the center
    let x, y;
    do {
      x = 70 + Math.random() * 420;
      y = 70 + Math.random() * 420;
    } while (x > 175 && x < 385 && y > 175 && y < 385);

    const circle = document.createElementNS(ns, 'circle');
    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', Math.random() * 1.5 + 0.5);
    circle.setAttribute('fill', '#E2C27A');
    circle.setAttribute('opacity', Math.random() * 0.4 + 0.1);
    overlayG.appendChild(circle);
    chartStars.push({ el: circle, phase: Math.random() * Math.PI * 2, speed: Math.random() * 0.03 + 0.01 });
  }

  // Animate twinkling
  let t = 0;
  function animate() {
    t += 0.015;
    chartStars.forEach(s => {
      const alpha = 0.1 + 0.35 * Math.abs(Math.sin(t * s.speed * 10 + s.phase));
      s.el.setAttribute('opacity', alpha.toFixed(3));
    });
    requestAnimationFrame(animate);
  }
  animate();
})();

/* ─── SCROLL REVEAL ─── */
(function() {
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  reveals.forEach(el => observer.observe(el));
})();

/* ─── FORM SUBMIT ─── */
function handleSubmit(event) {
  event.preventDefault();

  const form = event.target;
  const submitBtn = form.querySelector('button[type="submit"]');
  if (!submitBtn) return false;

  const dobInput = form.querySelector('#dob');
  const hourSelect = form.querySelector('#hour');

  let valid = true;
  if (!dobInput || !dobInput.value) {
    if (dobInput) dobInput.style.borderColor = 'red';
    valid = false;
  } else if (dobInput) {
    dobInput.style.borderColor = '';
  }
  if (!hourSelect || !hourSelect.value) {
    if (hourSelect) hourSelect.style.borderColor = 'red';
    valid = false;
  } else if (hourSelect) {
    hourSelect.style.borderColor = '';
  }
  if (!valid) return false;

  submitBtn.disabled = true;
  submitBtn.style.cursor = 'wait';
  submitBtn.style.opacity = '0.8';
  submitBtn.innerHTML = '◆ &nbsp; 正在推算命盘… &nbsp; ◆';

  const params = new URLSearchParams();
  new FormData(form).forEach(function(value, key) {
    const trimmed = String(value).trim();
    if (trimmed) params.set(key, trimmed);
  });

  setTimeout(function() {
    window.location.href = 'free-chart.html?' + params.toString();
  }, 250);

  return false;
}

