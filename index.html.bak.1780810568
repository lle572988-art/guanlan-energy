  <style>
  /* Privacy badge */
  .privacy-badge{font-size:10px;color:rgba(212,175,55,0.35);letter-spacing:0.5px;text-align:center;margin-top:14px;font-weight:300;font-family:'Inter',sans-serif}
  
  /* Five Elements Framework section */
  .elements-section{padding:100px 0 80px;border-top:1px solid rgba(212,175,55,0.06)}
  .elements-title{font-family:Garamond,Georgia,serif !important;font-size:clamp(28px,3.5vw,38px);color:var(--gold2);text-align:center;margin-bottom:8px;font-weight:700;letter-spacing:0.5px}
  .elements-subtitle{font-size:13px;color:var(--muted);text-align:center;letter-spacing:2px;margin-bottom:50px;font-weight:300}
  .elements-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:20px}
  .element-card{width:calc(33.333% - 14px);min-width:260px;flex-shrink:0}
  .element-card{background:rgba(255,255,255,0.02);border:1px solid rgba(212,175,55,0.10);border-radius:16px;padding:32px 28px;transition:all 0.3s ease}
  .element-card:hover{border-color:rgba(212,175,55,0.25);transform:translateY(-4px)}
  .element-icon{font-size:24px;margin-bottom:12px;color:var(--gold);opacity:0.6}
  .element-card h3{font-family:Garamond,Georgia,serif !important;font-size:18px;color:var(--gold2);margin-bottom:10px;font-weight:600;letter-spacing:0.5px}
  .element-card p{font-size:13px;color:rgba(232,228,219,0.55);line-height:1.7;font-weight:300;font-family:'Inter',sans-serif}
  .element-tag{display:inline-block;font-size:9px;letter-spacing:2px;text-transform:uppercase;padding:3px 10px;border-radius:999px;border:1px solid;margin-bottom:12px;font-weight:500;font-family:'Inter',sans-serif}
  
  /* Blueprint Contents section */
  .blueprint-section{padding:80px 0;border-top:1px solid rgba(212,175,55,0.06)}
  .blueprint-title{font-family:Garamond,Georgia,serif !important;font-size:clamp(24px,3vw,34px);color:var(--gold2);text-align:center;margin-bottom:6px;font-weight:700;letter-spacing:0.5px}
  .blueprint-subtitle{font-size:13px;color:var(--muted);text-align:center;letter-spacing:2px;margin-bottom:45px;font-weight:300}
  .blueprint-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .blueprint-card{background:rgba(255,255,255,0.02);border:1px solid rgba(212,175,55,0.08);border-radius:12px;padding:28px 24px;text-align:center;transition:all 0.3s ease}
  .blueprint-card:hover{border-color:rgba(212,175,55,0.2);transform:translateY(-3px)}
  .blueprint-card .icon{font-size:28px;margin-bottom:10px;display:block}
  .blueprint-card h4{font-family:Garamond,Georgia,serif !important;font-size:15px;color:var(--gold2);margin-bottom:6px;font-weight:600}
  .blueprint-card p{font-size:12px;color:rgba(232,228,219,0.5);line-height:1.6;font-weight:300;font-family:'Inter',sans-serif}
  
  @media(max-width:768px){
    .elements-grid{display:flex;flex-direction:column;align-items:center}
    .blueprint-grid{grid-template-columns:1fr}
  }
  </style>

