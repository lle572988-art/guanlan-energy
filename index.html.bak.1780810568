<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<style>body{opacity:0}body.css-ready{opacity:1;transition:opacity .15s ease}</style>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --ink:#06100c;--ink2:#0d1f17;
  --gold:#c9a84c;--gold2:#e8d4a0;--gold3:rgba(201,168,76,.12);
  --jade:#2d5a3d;--jade2:#1a3828;
  --text:#f0ebe0;--muted:rgba(240,235,224,.55);
  --wood:#4a7c59;--fire:#c0392b;--earth:#c9a84c;--metal:#b0b8c1;--water:#2c5f8a;
  --seal:#c23a2b;
}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--ink);color:var(--text);
  overflow-x:hidden;line-height:1.85;font-size:15px;
}
.bg-layer{
  position:fixed;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse 80% 60% at 10% 10%,rgba(45,90,61,.2) 0%,transparent 60%),
             radial-gradient(ellipse 60% 80% at 90% 90%,rgba(201,168,76,.06) 0%,transparent 55%),
             var(--ink);
}
.taiji-bg{
  position:fixed;inset:0;z-index:2;pointer-events:none;opacity:0.03;
  background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMjAwIDIwMCI+PGNpcmNsZSBjeD0iMTAwIiBjeT0iMTAwIiBjeT0iNjAiIGZpbGw9Im5vbmUiIHN0cm9rZT0iI2M5YTg0YyIgc3Ryb2tlLXdpZHRoPSIxIi8+PC9zdmY+");
}
nav{
  position:sticky;top:0;z-index:9999;
  background:rgba(9,9,11,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(212,175,55,.10);padding:16px 0;
}
.nav-inner{
  width:min(1200px,90%);margin:auto;
  display:flex;justify-content:space-between;align-items:center;
}
.nav-logo{display:flex;align-items:center;gap:12px;cursor:pointer}
.nav-logo svg{animation:spin 25s linear infinite}
.nav-name{font-family:'Cormorant Garamond',Georgia,serif;font-size:22px;letter-spacing:2px;color:var(--gold);font-weight:400}
.nav-sub{font-size:9px;letter-spacing:4px;color:var(--muted);margin-top:2px;text-transform:uppercase}
.nav-links{display:flex;gap:36px;align-items:center}
.nav-links a{
  color:rgba(232,228,219,.5);text-decoration:none;font-size:13px;
  letter-spacing:2.5px;font-family:'Cormorant Garamond',Georgia,serif;transition:color .4s ease;position:relative;
}
.nav-links a:hover{color:var(--gold2);text-shadow:0 0 20px rgba(212,175,55,.15)}
.nav-links a::after{
  content:'';position:absolute;bottom:-6px;left:50%;width:0;height:1px;
  background:var(--gold);transition:.3s;transform:translateX(-50%);
}
.nav-links a:hover::after{width:80%}
.hamburger{
  display:none;flex-direction:column;gap:6px;background:none;border:none;cursor:pointer;padding:4px;
}
.hamburger span{display:block;width:24px;height:1px;background:var(--gold);transition:.3s}
.mobile-menu{
  display:none;position:fixed;top:70px;left:0;width:100%;background:rgba(6,16,12,.98);
  border-bottom:1px solid rgba(201,168,76,.15);z-index:9998;flex-direction:column;
  align-items:center;padding:30px 0;gap:24px;box-shadow:0 10px 30px rgba(0,0,0,.5);
}
.mobile-menu.open{display:flex}
.mobile-menu a{color:var(--text);text-decoration:none;font-size:18px;letter-spacing:2px}

@media(max-width:768px){
  .nav-links{display:none}
  .hamburger{display:flex}
}
.wrap{position:relative;z-index:10;width:min(1200px,90%);margin:auto;padding-bottom:100px}
.hero{
  display:grid;grid-template-columns:1fr 1fr;gap:60px;
  min-height:85vh;padding:60px 0;align-items:center;
}
.hero-left{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.hero-right{display:flex;align-items:center;justify-content:center}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:999px;
  border:1px solid rgba(212,175,55,.25);background:rgba(212,175,55,.04);
  font-size:11px;letter-spacing:3px;color:var(--gold);margin-bottom:24px;text-transform:uppercase;
}
.hero h1{
  font-family:Garamond,Georgia,serif !important;font-size:clamp(36px,4.5vw,64px);
  font-weight:700;letter-spacing:0.5px;line-height:1.15;margin-bottom:16px;color:var(--text);
  text-align:left;
}
.hero h1 em{font-style:italic;color:var(--gold);font-weight:400}
.hero-desc{font-size:15px;color:var(--muted);max-width:480px;margin:0 0 32px;font-weight:300;text-align:left;line-height:1.7;letter-spacing:0.3px}
.form-card{
  background:rgba(11,15,25,.75);border:1px solid rgba(212,175,55,.14);
  border-radius:16px;padding:32px;max-width:480px;width:100%;
  backdrop-filter:blur(20px);box-shadow:0 20px 50px rgba(0,0,0,.4);
  text-align:left;position:relative;
}
.form-title{font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;color:var(--gold2);margin-bottom:4px;text-align:left;letter-spacing:0.5px;font-weight:600}
.form-subtitle{font-size:12px;color:var(--muted);margin-bottom:24px;text-align:left}
.field{margin-bottom:18px}
.field label{display:block;font-size:10px;letter-spacing:2px;color:rgba(212,175,55,.65);margin-bottom:6px;text-transform:uppercase}
.field input, .field select{
  width:100%;padding:12px 14px;border-radius:8px;border:1px solid rgba(212,175,55,.14);
  background:rgba(9,9,11,.7);color:var(--text);font-size:14px;outline:none;transition:.3s;
  font-family:inherit;
}
.field input:focus, .field select:focus{border-color:var(--gold);box-shadow:0 0 8px rgba(212,175,55,.2)}
.fields-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.submit-btn{
  width:100%;padding:14px;border-radius:999px;border:none;
  background:linear-gradient(135deg, rgba(212,175,55,.25), rgba(212,175,55,.08));
  border:1px solid rgba(212,175,55,.35);color:var(--gold2);
  font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;letter-spacing:2px;
  cursor:pointer;transition:all 0.3s ease;margin-top:6px;font-weight:500;
}
.submit-btn:hover{transform:translateY(-2px);box-shadow:0 0 20px rgba(212,175,55,0.2),0 10px 25px rgba(212,175,55,.18)}

/* Hero Wheel — Pure CSS Celestial Mandala */
.hero-wheel-container{
  width:100%;max-width:580px;aspect-ratio:1;border-radius:50%;
  border:1px dashed rgba(212,175,55,0.15);
  display:flex;align-items:center;justify-content:center;position:relative;
  background:radial-gradient(circle, rgba(212,175,55,0.12) 0%, rgba(212,175,55,0.03) 45%, transparent 75%);
  box-shadow:0 0 60px rgba(212,175,55,0.08);
  overflow:hidden;
}
/* Meridian cross-axis (子午卯酉 celestial axes) */
.hero-wheel-container::before,
.hero-wheel-container::after{
  content:'';position:absolute;z-index:4;
  background:rgba(212,175,55,0.08);
}
.hero-wheel-container::before{
  width:1px;height:100%;left:50%;transform:translateX(-50%);
}
.hero-wheel-container::after{
  width:100%;height:1px;top:50%;transform:translateY(-50%);
}
.element-particle{
  position:absolute;display:flex;align-items:center;gap:6px;z-index:7;
  font-family:'Cormorant Garamond',Garamond,Georgia,serif;font-size:14px;letter-spacing:0.15em;
  color:rgba(212,175,55,0.55);opacity:0;
  animation:cosmicPulse 10s infinite ease-in-out;
  pointer-events:none;user-select:none;font-weight:600;
}
@keyframes cosmicPulse{
  0%{opacity:0;transform:translateY(8px) scale(0.95)}
  30%{opacity:0.45;transform:translateY(0) scale(1);filter:drop-shadow(0 0 8px rgba(212,175,55,0.3))}
  70%{opacity:0.45;transform:translateY(-4px) scale(1)}
  100%{opacity:0;transform:translateY(-12px) scale(0.95)}
}

.hero-wheel-ring-1{
  width:80%;height:80%;border-radius:50%;
  border:1.5px solid rgba(212,175,55,0.16);
  border-left-color:rgba(212,175,55,0.4);
  animation:spin 60s linear infinite;
}
.hero-wheel-ring-2{
  position:absolute;width:55%;height:55%;border-radius:50%;
  border:1px solid rgba(212,175,55,0.08);
  border-top-color:rgba(212,175,55,0.25);
  animation:spin 40s linear infinite reverse;
}
.hero-wheel-ring-3{
  position:absolute;width:35%;height:35%;border-radius:50%;
  border:1px solid rgba(212,175,55,0.06);
  border-right-color:rgba(212,175,55,0.2);
  animation:spin 30s linear infinite;
}
.hero-wheel-taichi{
  position:absolute;width:76px;height:76px;border-radius:50%;
  background:rgba(212,175,55,0.06);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 40px rgba(212,175,55,0.12);
  z-index:5;
}
.hero-wheel-taichi svg{opacity:0.5;animation:spin 20s linear infinite reverse;filter:drop-shadow(0 0 12px rgba(212,175,55,0.4))}

/* Typographic Element Drift — using inline keyframes injected in HTML */

@keyframes spin{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}

/* Mobile: stack to single column */
@media(max-width:900px){
  .hero{grid-template-columns:1fr;gap:40px;text-align:center}
  .hero-left{align-items:center}
  .hero h1,.hero-desc,.form-card{text-align:center}
  .form-card{max-width:100%}
  .hero-wheel-container{max-width:320px;margin:0 auto}
}
.loading-overlay{
  display:none;position:fixed;inset:0;background:rgba(6,16,12,.96);
  z-index:10000;align-items:center;justify-content:center;flex-direction:column;
}
.loading-overlay.show{display:flex}
.loading-icon{width:60px;height:60px;margin-bottom:24px;animation:spin 4s linear infinite}
.loading-text{font-family:'Cormorant Garamond',Georgia,serif;font-size:22px;color:var(--gold);letter-spacing:2px;margin-bottom:20px;font-weight:700}
.loading-steps{display:flex;flex-direction:column;gap:10px;align-items:flex-start}
.lstep{font-size:14px;color:rgba(240,235,224,.3);transition:.4s}
.lstep.active{color:var(--gold);font-weight:bold}
.lstep.done{color:rgba(240,235,224,.6)}

#results{display:none;padding-top:100px;margin-top:-50px}
.report-header{
  text-align:center;padding:50px 30px;background:rgba(13,31,23,.4);
  border:1px solid rgba(201,168,76,.12);border-radius:24px;margin-bottom:32px;
}
.report-badge{
  display:inline-block;padding:4px 14px;border-radius:999px;
  border:1px solid var(--el-color, var(--gold));color:var(--el-color, var(--gold));
  font-size:11px;letter-spacing:2px;margin-bottom:16px;text-transform:uppercase;font-weight:500;
}
.report-main-title{font-family:Garamond,Georgia,serif !important;font-size:38px;color:var(--text);margin-bottom:12px;font-weight:700}
.report-subtitle{font-size:15px;color:var(--gold2);letter-spacing:1px}
.chart-block{
  background:rgba(13,31,23,.6);border:1px solid rgba(201,168,76,.1);
  border-radius:20px;padding:36px;margin-bottom:32px;
}

.element-wheel-section{max-width:600px;margin:0 auto 20px}
.wheel-wrap{display:flex;align-items:center;gap:32px;justify-content:center;flex-wrap:wrap}
.element-ring-svg{flex-shrink:0}
.ring-legend{display:flex;flex-direction:column;gap:8px}
.ring-legend-item{display:flex;align-items:center;gap:8px;font-size:12px}
.ring-dot{width:8px;height:8px;border-radius:50%;border:1.5px solid;flex-shrink:0}
.ring-label{color:rgba(232,228,219,0.6);min-width:40px;font-family:'Inter',sans-serif}
.ring-pct{color:rgba(212,175,55,0.5);font-family:'Cormorant Garamond',Georgia,serif;min-width:30px;text-align:right}
@media(max-width:500px){.wheel-wrap{flex-direction:column;gap:16px}.element-ring-svg{width:180px;height:180px}}

.block-title{
  font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;color:var(--gold);
  letter-spacing:2px;margin-bottom:24px;display:flex;align-items:center;gap:10px;text-transform:uppercase;
}
.block-title::after{content:'';flex:1;height:1px;background:rgba(201,168,76,.15)}
.bar-group{display:flex;flex-direction:column;gap:18px}
.bar-row{display:flex;align-items:center;gap:16px}
.bar-label{width:90px;font-family:'Cormorant Garamond',Georgia,serif;font-size:16px;letter-spacing:1px}
.bar-track{flex:1;height:10px;background:rgba(255,255,255,.05);border-radius:999px;overflow:hidden}
.bar-fill{height:100%;border-radius:999px;width:0;transition:width 1.5s ease-out}
.bar-val{width:140px;text-align:right;font-size:14px;color:var(--muted)}
.analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px}
@media(max-width:768px){.analysis-grid{grid-template-columns:1fr}}
.analysis-card{
  background:rgba(13,31,23,.6);border:1px solid rgba(201,168,76,.1);
  border-radius:20px;padding:28px;transition:.3s;
}
.analysis-card:hover{border-color:rgba(201,168,76,.3);transform:translateY(-2px)}
.card-head{font-family:'Cormorant Garamond',Georgia,serif;font-size:20px;color:var(--gold2);margin-bottom:12px}

    .wealth-tip-card{max-width:580px;margin:0 auto 30px;padding:28px 24px 20px;border:0.5px solid rgba(212,175,55,0.12);border-radius:16px;background:linear-gradient(135deg,rgba(212,175,55,0.03),transparent)}
    .tip-header{display:flex;align-items:center;gap:8px;margin-bottom:14px}
    .tip-header svg{flex-shrink:0}
    .tip-header span{font-family:'Cormorant Garamond',Georgia,serif;font-size:13px;letter-spacing:2px;color:rgba(212,175,55,0.6)}
    .tip-badge{font-size:9px;letter-spacing:1px;padding:2px 8px;border:0.5px solid rgba(212,175,55,0.15);border-radius:999px;color:rgba(212,175,55,0.4)}
    .tip-content{display:flex;gap:12px;align-items:flex-start}
    .tip-icon{flex-shrink:0;width:24px;text-align:center;margin-top:2px}
    .tip-body{flex:1}
    .tip-title{display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:14px;color:var(--gold2);margin-bottom:4px}
    .tip-text{display:block;font-size:13px;color:rgba(232,228,219,0.6);line-height:1.7}
    .tip-footer{font-size:10px;text-align:center;color:rgba(212,175,55,0.25);margin-top:12px;letter-spacing:1px}

.card-text{font-size:15px;color:rgba(240,235,224,.75);line-height:1.75;text-align:justify}

.comparison-table{max-width:580px;margin:30px auto 20px;padding:0;border:0.5px solid rgba(212,175,55,0.12);border-radius:12px}
.table-title{text-align:center;font-family:'Cormorant Garamond',Georgia,serif;font-size:14px;letter-spacing:2px;color:rgba(212,175,55,0.5);margin-bottom:16px}
.table-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;font-size:12px;padding:4px 8px}
.table-header{padding:8px 6px;text-align:center;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;border-bottom:0.5px solid rgba(212,175,55,0.1)}
.table-hdr-blank{}
.table-hdr-free{color:rgba(212,175,55,0.4)}
.table-hdr-premium{color:var(--gold)}
.table-row-label{padding:8px 6px;border-bottom:0.5px solid rgba(212,175,55,0.06);color:rgba(232,228,219,0.6);font-size:11px;letter-spacing:0.3px}
.table-cell{padding:8px 6px;border-bottom:0.5px solid rgba(212,175,55,0.06);color:rgba(232,228,219,0.4);font-size:11px;line-height:1.5}
.table-cell-premium{color:rgba(232,228,219,0.75)}
.tick-checked{color:#D4AF37}
.lucky-banner{
  background:rgba(201,168,76,.05);border:1px solid rgba(201,168,76,.2);
  border-radius:20px;padding:30px;margin-bottom:40px;
}

.element-wheel-section{max-width:600px;margin:0 auto 20px}
.wheel-wrap{display:flex;align-items:center;gap:32px;justify-content:center;flex-wrap:wrap}
.element-ring-svg{flex-shrink:0}
.ring-legend{display:flex;flex-direction:column;gap:8px}
.ring-legend-item{display:flex;align-items:center;gap:8px;font-size:12px}
.ring-dot{width:8px;height:8px;border-radius:50%;border:1.5px solid;flex-shrink:0}
.ring-label{color:rgba(232,228,219,0.6);min-width:40px;font-family:'Inter',sans-serif}
.ring-pct{color:rgba(212,175,55,0.5);font-family:'Cormorant Garamond',Georgia,serif;min-width:30px;text-align:right}

.daily-timer{max-width:580px;margin:0 auto 30px;padding:24px;border:0.5px solid rgba(212,175,55,0.1);border-radius:16px;background:linear-gradient(135deg,rgba(212,175,55,0.02),rgba(255,255,255,0.01))}
.timer-header{display:flex;align-items:center;gap:8px;margin-bottom:16px}
.timer-header span{font-family:'Cormorant Garamond',Georgia,serif;font-size:13px;letter-spacing:2px;color:rgba(212,175,55,0.5)}
.timer-badge{font-size:9px;letter-spacing:1px;padding:2px 8px;border:0.5px solid rgba(212,175,55,0.15);border-radius:999px;color:rgba(212,175,55,0.3);margin-left:auto}
.timer-content{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.timer-row{text-align:center;padding:12px 8px;border:0.5px solid rgba(212,175,55,0.06);border-radius:8px;background:rgba(255,255,255,0.01)}
.timer-value{font-family:'Cormorant Garamond',Georgia,serif;font-size:15px;color:var(--gold2);margin-bottom:4px;letter-spacing:0.5px}
.timer-label{font-size:9px;color:rgba(212,175,55,0.3);letter-spacing:1.5px;text-transform:uppercase}
.timer-footer{font-size:9px;text-align:center;color:rgba(212,175,55,0.2);margin-top:14px;letter-spacing:1px}

.premium-preview{max-width:580px;margin:0 auto 24px;padding:20px 24px;border:0.5px solid rgba(212,175,55,0.08);border-radius:12px}
.preview-grid{display:flex;flex-direction:column;gap:10px}
.preview-item{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:rgba(232,228,219,0.45);line-height:1.6}
.preview-icon{color:rgba(212,175,55,0.3);font-size:10px;margin-top:3px}
.preview-title{font-family:'Cormorant Garamond',Georgia,serif;font-size:13px;letter-spacing:2px;color:rgba(212,175,55,0.5);text-align:center;margin-bottom:14px;text-transform:uppercase}
.preview-cta-hint{font-size:9px;text-align:center;color:rgba(212,175,55,0.2);margin-top:12px;letter-spacing:1px}

/* Card visual upgrade */
.analysis-card{background:linear-gradient(135deg,rgba(255,255,255,0.02),rgba(255,255,255,0.005));border:0.5px solid rgba(212,175,55,0.08);border-radius:16px;padding:24px;position:relative;overflow:hidden}
.analysis-card::before{content:'';position:absolute;left:0;top:10%;bottom:10%;width:1.5px;background:linear-gradient(180deg,transparent,rgba(212,175,55,0.2),transparent)}
.card-head{font-size:15px;letter-spacing:0.5px}
.card-text{font-size:13.5px;line-height:1.7}
.lucky-title{font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;color:var(--gold);text-align:center;margin-bottom:20px;letter-spacing:2px}
.lucky-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;text-align:center}
@media(max-width:560px){.lucky-grid{grid-template-columns:1fr 1fr}}
.lucky-item{background:rgba(6,16,12,.5);padding:16px;border-radius:12px;border:1px solid rgba(201,168,76,.08)}
.lucky-name{font-size:11px;color:var(--muted);letter-spacing:1px;margin-bottom:4px;text-transform:uppercase}
.lucky-value{font-size:16px;color:var(--text);font-weight:500}

/* --- Shard Container --- */
.shard-quote{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:22px;font-weight:600;line-height:1.4;
  margin-bottom:24px;padding:12px 0;
  background:linear-gradient(135deg, #D4AF37, #F5E6B8, #D4AF37);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  letter-spacing:0.5px;
  border-bottom:1px solid rgba(212,175,55,0.08);
}
.shard-grid{display:flex;flex-direction:column;gap:20px;margin-bottom:24px}
.wealth-shards{display:flex;flex-direction:column;gap:0}
.shard-row{display:flex;gap:12px;align-items:flex-start;padding:12px 0}
.shard-icon{flex-shrink:0;margin-top:2px;width:20px;text-align:center}
.shard-content{flex:1}
.shard-sub{display:block;font-family:'Cormorant Garamond',Georgia,serif;font-size:12px;letter-spacing:2px;color:rgba(212,175,55,0.5);margin-bottom:4px;text-transform:uppercase}
.shard-text{display:block;font-size:14px;line-height:1.7;color:rgba(232,228,219,0.75)}
.shard-divider{height:0;border:none;border-top:0.5px solid rgba(212,175,55,0.06);margin:2px 0}

.shard-block{
  background:rgba(255,255,255,0.015);
  border:0.5px solid rgba(212,175,55,0.06);
  border-radius:12px;padding:18px 20px;
}
.shard-label{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:12px;letter-spacing:2px;
  color:rgba(212,175,55,0.5);
  margin-bottom:8px;text-transform:uppercase;
}
.shard-body{font-size:14px;line-height:1.7;color:rgba(240,235,224,0.78)}
/* --- Resonant Mediums Grid --- */
.medium-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
  margin-top:20px;padding-top:16px;
  border-top:0.5px solid rgba(212,175,55,0.08);
}
.medium-col{
  background:rgba(255,255,255,0.008);
  border:0.5px solid rgba(212,175,55,0.04);
  border-radius:10px;padding:14px 16px;
}
.medium-label{
  display:flex;align-items:center;gap:6px;
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:11px;letter-spacing:1.5px;
  color:rgba(212,175,55,0.6);
  margin-bottom:10px;text-transform:uppercase;
}
.medium-tag{
  display:inline-block;
  font-size:12px;line-height:1.5;
  color:rgba(240,235,224,0.5);
  margin-bottom:4px;
}
.medium-tag::before{content:'\u2192 ';color:rgba(212,175,55,0.3)}
@media(max-width:640px){.medium-grid{grid-template-columns:1fr}}

.premium-cta{
  text-align:center;background:linear-gradient(180deg, rgba(201,168,76,.08) 0%, rgba(13,31,23,.9) 100%);
  border:2px solid var(--gold);border-radius:28px;padding:50px 40px;position:relative;overflow:hidden;
}
.premium-chart-hint{
  position:absolute;bottom:40px;left:10%;width:80%;height:100px;z-index:1;
  opacity:0.25;pointer-events:none;
  background:
    repeating-linear-gradient(90deg, rgba(212,175,55,0.08) 0px, rgba(212,175,55,0.08) 1px, transparent 1px, transparent 20px),
    repeating-linear-gradient(0deg, rgba(212,175,55,0.08) 0px, rgba(212,175,55,0.08) 1px, transparent 1px, transparent 24px),
    linear-gradient(135deg, rgba(212,175,55,0.03) 0%, transparent 80%);
  border-radius:8px;
}

.premium-cta::before{
  content:'';position:absolute;top:0;left:-50%;width:200%;height:100%;
  background:linear-gradient(to right, transparent, rgba(255,255,255,0.03), transparent);
  transform:skewX(-30deg);animation:shine 6s infinite linear;
}
@keyframes shine {0% {left: -50%} 100% {left: 150%}}
.cta-badge{color:var(--seal);font-family:'Cormorant Garamond',Georgia,serif;font-size:12px;letter-spacing:3px;font-weight:bold;margin-bottom:12px}
.cta-title{font-family:Garamond,Georgia,serif !important;font-size:32px;color:var(--gold2);margin-bottom:16px;letter-spacing:1px;font-weight:700}
.cta-desc{font-size:15.5px;color:var(--muted);max-width:680px;margin:0 auto 30px;line-height:1.75}
.cta-btn{
  display:inline-block;padding:18px 48px;border-radius:999px;background:var(--gold);
  color:var(--ink);text-decoration:none;font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;
  font-size:16px;letter-spacing:2px;box-shadow:0 10px 30px rgba(201,168,76,0.3);transition:.3s;
}
.cta-btn:hover{transform:translateY(-3px);background:var(--gold2);box-shadow:0 15px 40px rgba(201,168,76,0.5)}

/* 订阅弹窗样式 */
.subscribe-overlay{
  position:fixed;inset:0;background:rgba(6,16,12,.85);backdrop-filter:blur(10px);
  z-index:100000;display:none;align-items:center;justify-content:center;padding:20px;
}
.subscribe-overlay.open{display:flex}
.subscribe-card{
  background:var(--ink2);border:1px solid var(--gold);border-radius:24px;
  padding:40px;max-width:460px;width:100%;text-align:center;position:relative;
  box-shadow:0 30px 60px rgba(0,0,0,.6);
}

footer{text-align:center;padding:40px 0;border-top:1px solid rgba(201,168,76,.08);margin-top:60px;font-size:12px;color:var(--muted);letter-spacing:1px}
}
